      },
      "export": {
        "title": "异步处理",
        "description": "集成 Inngest 后台任务引擎，支持异步处理、任务队列和状态轮询，突破请求超时限制。"
      },
      "batch": {
        "title": "国际化",
        "description": "集成 next-intl 多语言支持，内置中英双语翻译，轻松扩展更多语言。"
      },
      "multilingual": {
        "title": "管理后台",
